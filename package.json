{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=20.19"
    },
    "scripts": {
        "build": "vite build",
        "build:ssr": "vite build && vite build --ssr",
        "dev": "run-p dev:vite dev:laravel",
        "dev:vite": "vite",
        "dev:laravel": "php artisan serve",
        "format": "prettier --write resources/",
        "format:check": "prettier --check resources/",
        "lint": "eslint . --fix",
        "lint:check": "eslint .",
        "types:check": "svelte-check --tsconfig ./tsconfig.json",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "devDependencies": {
        "@eslint/js": "^9.19.0",
        "@laravel/vite-plugin-wayfinder": "^0.1.3",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@tailwindcss/vite": "^4.1.11",
        "@testing-library/jest-dom": "^7.0.0",
        "@testing-library/svelte": "^5.4.2",
        "@types/node": "^22.13.5",
        "concurrently": "^9.0.1",
        "eslint": "^9.17.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-import-resolver-typescript": "^4.4.4",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-svelte": "^3.1.0",
        "jsdom": "^30.0.1",
        "prettier": "^3.4.2",
        "prettier-plugin-svelte": "^3.3.3",
        "prettier-plugin-tailwindcss": "^0.6.11",
        "svelte-check": "^4.1.4",
        "typescript": "^5.7.2",
        "typescript-eslint": "^8.23.0",
        "vite": "^8.0.0",
        "vitest": "^4.1.10"
    },
    "dependencies": {
        "@inertiajs/svelte": "^3.0.0",
        "@inertiajs/vite": "^3.0.0",
        "@laravel/passkeys": "^0.2.0",
        "@lucide/svelte": "^1.24.0",
        "@sveltejs/vite-plugin-svelte": "^7.0.0",
        "@tanstack/table-core": "^8.21.3",
        "bits-ui": "^2.15.0",
        "clsx": "^2.1.1",
        "d3-scale": "^4.0.2",
        "d3-shape": "^3.2.0",
        "embla-carousel-svelte": "^8.6.0",
        "formsnap": "^2.0.1",
        "laravel-vite-plugin": "^3.0.0",
        "layerchart": "^2.0.0-next.65",
        "npm-run-all": "^4.1.5",
        "paneforge": "^1.0.2",
        "svelte": "^5.16.0",
        "svelte-sonner": "^0.3.28",
        "sveltekit-superforms": "^2.30.2",
        "tailwind-merge": "^3.2.0",
        "tailwind-variants": "^3.2.2",
        "tailwindcss": "^4.1.1",
        "tw-animate-css": "^1.2.5",
        "vanilla-cookieconsent": "^3.1.0",
        "vaul-svelte": "^0.3.2"
    },
    "optionalDependencies": {
        "@rollup/rollup-linux-x64-gnu": "4.9.5",
        "@rollup/rollup-win32-x64-msvc": "4.9.5",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.0.1",
        "@tailwindcss/oxide-win32-x64-msvc": "^4.0.1",
        "lightningcss-linux-x64-gnu": "^1.29.1",
        "lightningcss-win32-x64-msvc": "^1.29.1"
    }
}
