# ============================================
# Production Dockerfile — dormed24 Shop
# Multi-stage, zwei Images aus einem Build:
#   app — PHP-FPM + Nginx (Supervisor). Dasselbe Image läuft in compose.yaml
#         auch als Queue-Worker und Scheduler, nur mit anderem Befehl.
#   ssr — Node, rendert Inertia-Seiten serverseitig (INERTIA_SSR_URL).
# ============================================

# ---- Build Stage ----
FROM php:8.4-cli-bookworm AS build

RUN apt-get update && apt-get install -y --no-install-recommends \
    libzip-dev libpng-dev libonig-dev libxml2-dev libicu-dev libcurl4-openssl-dev \
    unzip ca-certificates curl git \
    && docker-php-ext-install -j$(nproc) zip bcmath intl \
    && rm -rf /var/lib/apt/lists/*

# Node.js 22 (nur Build)
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /build

# Layer 1: PHP-Abhängigkeiten
COPY composer.json composer.lock ./
RUN composer install --no-dev --optimize-autoloader --no-scripts --no-interaction --no-progress

# Layer 2: Frontend-Abhängigkeiten
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

# Layer 3: App-Quellcode
COPY . .

# Laravel bootstrappen und Assets bauen (ohne Seeding, ohne Migrationen)
RUN mkdir -p database && touch database/database.sqlite \
    && php artisan package:discover --ansi \
    && php artisan wayfinder:generate --with-form \
    && npm run build:ssr \
    && rm -rf node_modules

# ---- SSR-Server ----
# Das Bundle in bootstrap/ssr lädt seine Abhängigkeiten zur Laufzeit aus
# node_modules; dafür reichen die Laufzeit-Pakete ohne Dev-Abhängigkeiten.
FROM node:22-bookworm-slim AS ssr

WORKDIR /app
ENV NODE_ENV=production

COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund \
    && npm cache clean --force

COPY --from=build /build/bootstrap/ssr ./bootstrap/ssr

USER node
EXPOSE 13714

HEALTHCHECK --interval=10s --timeout=3s --start-period=10s --retries=3 \
    CMD node -e "fetch('http://127.0.0.1:13714/health').then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"

CMD ["node", "bootstrap/ssr/app.js"]

# ---- App (Web, Queue, Scheduler) ----
FROM php:8.4-fpm-bookworm AS app

# Runtime: Nginx + Supervisor, PHP mit Postgres (pdo_pgsql) und Redis
# (phpredis für Queue, Cache und Sessions). pcntl, damit queue:work bei
# SIGTERM den laufenden Job zu Ende bringt. gd (mit WebP und AVIF) und exif
# wandeln hochgeladene Produktbilder in WebP und AVIF um (App\Support\Images). PDO, pdo_sqlite, mbstring und xml
# bringt das Basis-Image schon mit; pdo_sqlite braucht nur noch der einmalige
# Datenumzug (php artisan db:import-sqlite).
RUN apt-get update && apt-get install -y --no-install-recommends \
    nginx supervisor curl \
    libzip-dev libonig-dev libxml2-dev libicu-dev libpq-dev \
    libpng-dev libjpeg-dev libwebp-dev libavif-dev \
    && docker-php-ext-configure gd --with-jpeg --with-webp --with-avif \
    && docker-php-ext-install -j$(nproc) pdo_pgsql pcntl zip bcmath intl gd exif \
    && pecl install redis \
    && docker-php-ext-enable redis \
    && rm -rf /var/lib/apt/lists/* /tmp/pear

COPY docker/nginx.conf         /etc/nginx/nginx.conf
COPY docker/php.ini           /usr/local/etc/php/conf.d/zz-dormed24.ini
COPY docker/supervisord.conf   /etc/supervisor/conf.d/dormed24.conf
COPY docker/entrypoint.sh      /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

# Build-Artefakte ohne node_modules, .git und Dev-Abhängigkeiten
COPY --from=build /build /app

WORKDIR /app

# storage gehört www-data: Ein neues Volume übernimmt Inhalt und Besitzer
# aus dem Image. public/storage zeigt auf die hochgeladenen Dateien.
RUN chown -R www-data:www-data storage bootstrap/cache \
    && ln -sfn /app/storage/app/public /app/public/storage

# Laufzeit-Defaults — compose.yaml/.env überschreibt APP_KEY, Zugangsdaten und Co.
# Datenbank ist Postgres, Queue, Cache und Sessions laufen über Redis.
ENV APP_ENV=production \
    APP_DEBUG=false \
    LOG_LEVEL=warning \
    APP_KEY="" \
    DB_CONNECTION=pgsql \
    QUEUE_CONNECTION=redis \
    CACHE_STORE=redis \
    SESSION_DRIVER=redis \
    REDIS_CLIENT=phpredis \
    LOG_CHANNEL=stderr

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD curl -fsS http://localhost/up || exit 1

EXPOSE 80

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["/usr/bin/supervisord", "-n", "-c", "/etc/supervisor/supervisord.conf"]
