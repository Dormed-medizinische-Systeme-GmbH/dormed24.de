APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Einziger Admin-Zugang (/admin). ADMIN_PASSWORD ist ein bcrypt-Hash, in
# einfachen Anführungszeichen: php artisan tinker --execute 'echo Hash::make("…");'
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Inertia SSR (Server-Side Rendering für Crawler/Link-Vorschauen).
# Lokal aus lassen; in Produktion:
#   1) npm run build:ssr   (baut bootstrap/ssr/app.js)
#   2) INERTIA_SSR_ENABLED=true
#   3) php artisan inertia:start-ssr als Dauerprozess (Supervisor/systemd)
INERTIA_SSR_ENABLED=false

APP_LOCALE=de
APP_FALLBACK_LOCALE=de
APP_FAKER_LOCALE=de_DE

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Postgres. Lokal: `docker compose -f compose.dev.yaml up -d` startet Postgres
# und Redis mit genau diesen Werten. Im Docker-Stack (compose.yaml) setzt
# compose DB_HOST/REDIS_HOST selbst; DB_PASSWORD dort unbedingt ändern.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=dormed24
DB_USERNAME=dormed24
DB_PASSWORD=dormed24

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# In Produktion (HTTPS) aktivieren — Session-Cookie nur über TLS (Launch-Checkliste):
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Nur Docker-Stack (compose.yaml): Port, unter dem die App auf dem Host erreichbar ist.
# APP_PORT=8080

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# -----------------------------------------------------------
# PayPal & SMTP — nur aus der Env (nicht mehr in der Datenbank).
# Live-Werte werden NUR bei APP_ENV=production und APP_DEBUG=false
# genutzt, sonst die Sandbox-Werte (inkl. Sandbox-Banner im Shop).
# -----------------------------------------------------------

PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=
PAYPAL_SANDBOX_MERCHANT_ID=
PAYPAL_SANDBOX_WEBHOOK_ID=

PAYPAL_LIVE_CLIENT_ID=
PAYPAL_LIVE_CLIENT_SECRET=
PAYPAL_LIVE_APP_ID=
PAYPAL_LIVE_MERCHANT_ID=
PAYPAL_LIVE_WEBHOOK_ID=

# Ohne Host für den aktiven Modus bleibt MAIL_MAILER (oben) aktiv.
MAIL_SANDBOX_HOST=
MAIL_SANDBOX_PORT=587
MAIL_SANDBOX_USERNAME=
MAIL_SANDBOX_PASSWORD=
MAIL_SANDBOX_FROM_ADDRESS=

MAIL_LIVE_HOST=
MAIL_LIVE_PORT=587
MAIL_LIVE_USERNAME=
MAIL_LIVE_PASSWORD=
MAIL_LIVE_FROM_ADDRESS=
