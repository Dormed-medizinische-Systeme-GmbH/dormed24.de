APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Einziger Admin-Zugang (/admin). ADMIN_PASSWORD ist ein bcrypt-Hash:
# php artisan admin:hash-password
ADMIN_NAME=Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Inertia SSR (Server-Side Rendering für Crawler/Link-Vorschauen).
# Lokal aus lassen; in Produktion:
#   1) npm run build:ssr   (baut bootstrap/ssr/app.js)
#   2) INERTIA_SSR_ENABLED=true
#   3) php artisan inertia:start-ssr als Dauerprozess (Supervisor/systemd)
INERTIA_SSR_ENABLED=false

APP_LOCALE=de
APP_FALLBACK_LOCALE=de
APP_FAKER_LOCALE=de_DE

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# In Produktion (HTTPS) aktivieren — Session-Cookie nur über TLS (Launch-Checkliste):
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# -----------------------------------------------------------
# PaymentSeeder — Werte werden via `php artisan db:seed --class=PaymentSeeder`
# in die settings-Tabelle geschrieben. Nur gesetzte Werte werden übernommen.
# -----------------------------------------------------------

# PayPal — Sandbox
SEED_PAYPAL_SANDBOX_CLIENT_ID=
SEED_PAYPAL_SANDBOX_CLIENT_SECRET=
SEED_PAYPAL_SANDBOX_MERCHANT_ID=

# PayPal — Live
SEED_PAYPAL_LIVE_CLIENT_ID=
SEED_PAYPAL_LIVE_CLIENT_SECRET=
SEED_PAYPAL_LIVE_APP_ID=
SEED_PAYPAL_LIVE_MERCHANT_ID=

# PayPal — Webhook
SEED_PAYPAL_WEBHOOK_ID=
